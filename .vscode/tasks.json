{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Accounting System",
      "type": "shell",
      "command": "python app.py",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Automated Tests (TC-01 to TC-15)",
      "type": "shell",
      "command": "pytest -v tests/",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "problemMatcher": []
    }
  ]
}
